repository-code: "https://github.com/MohammadMD1383/jdx"
url: "https://mohammadmd1383.github.io/jdx/"
license: Apache-2.0
keywords:
  - AI coding agents
  - Model Context Protocol
  - Java
  - Kotlin
  - JVM
  - bytecode
  - code navigation
  - developer tools
