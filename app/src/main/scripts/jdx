#!/bin/sh
# jdx launcher — POSIX sh (T-004).
#
# This script is the only supported entry point for end users. It is intentionally dumb:
# no config, no colour, no argument parsing — the JVM owns all of that. Its three jobs:
#
#   1. find a Java 21+ runtime:  $JAVA_HOME  ->  `java` on PATH  ->
#      `/usr/libexec/java_home` (macOS only)  ->  $JDX_JVM_DEFAULT_DIR
#      (default /usr/lib/jvm/default, the Arch layout; JDX_JVM_DEFAULT_DIR exists mainly so
#      the no-JDK error path is testable on a machine that always has a JDK, and secondarily
#      for non-Arch users — see D-026). The macOS helper path itself is overridable via
#      $JDX_JAVA_HOME_HELPER (default /usr/libexec/java_home) for the same reason: the
#      no-helper sandbox and the helper branch are otherwise untestable where a real
#      helper exists.
#   2. fail with one human-readable line on stderr — never a stack trace — if it cannot
#      (missing JDK, JDK too old, missing build). Exit code 6 (D-015/D-026).
#   3. exec the fat jar with the one-shot CLI JVM flags (PROPOSAL.md §15):
#      -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -Xshare:auto
#      plus -XX:SharedArchiveFile when the AppCDS archive (T-048,
#      app/build/libs/jdx.jsa, shipped by :app:installDist) sits next to the
#      fat jar. A missing or stale archive degrades to the plain run via
#      -Xshare:auto, never a hard failure — so this is a presence check only,
#      no version probing.
#
# install.sh symlinks this file into ~/.local/bin, so the fat jar is located relative to
# the *resolved* script path, not $0: GNU `readlink -f` when it works, otherwise a
# portable loop over plain `readlink` (BSD/macOS `readlink` has no `-f`, and rejects
# `--`, so neither flag is used here).

minimum_java_major=21

die() {
    printf 'jdx: %s\n' "$*" >&2
    exit 6
}

# External tools this script needs: `sed` only. `readlink` is optional (guarded below) and
# `dirname` is deliberately avoided in favour of POSIX parameter expansion, so a stripped
# PATH still yields one clean error instead of shell noise (found by T-004's fault tests).
command -v sed >/dev/null 2>&1 || die "the 'sed' tool is required but not on PATH"

self=$0
# Portable symlink resolution: prefer GNU `readlink -f` when the readlink at hand
# supports it; otherwise walk the chain with plain POSIX `readlink`, resolving
# relative targets against the link's own directory. Bounded (32 hops) so a link
# cycle degrades to using $0, never to an infinite loop.
if resolved=$(readlink -f "$self" 2>/dev/null) && [ -n "$resolved" ]; then
    self=$resolved
else
    depth=0
    while [ "$depth" -lt 32 ] && link=$(readlink "$self" 2>/dev/null) && [ -n "$link" ]; do
        case $link in
            /*) self=$link ;;
            *)
                case $self in
                    */*) self=${self%/*}/$link ;;
                    *) self=./$link ;;
                esac
                ;;
        esac
        depth=$((depth + 1))
    done
    unset link depth resolved
fi
# $0 always contains a slash for an exec'd script (absolute path or resolved from PATH).
case $self in
    */*) jdx_home=${self%/*} ;;
    *)   jdx_home=. ;;
esac

jar=
for candidate in "$jdx_home"/libs/jdx-*-all.jar; do
    [ -f "$candidate" ] || continue
    jar=$candidate
    break
done
[ -n "$jar" ] || die "no jdx fat jar in '$jdx_home/libs' — build it first: ./gradlew :app:installDist"

# An explicitly set JAVA_HOME that is broken is a loud error, not a silent fall-through to
# PATH: a user who sets JAVA_HOME wants *that* JDK, and quietly picking another one hides
# the real problem (D-026).
java_exe=
if [ -n "${JAVA_HOME:-}" ]; then
    [ -x "$JAVA_HOME/bin/java" ] || die "JAVA_HOME is set to '$JAVA_HOME' but \$JAVA_HOME/bin/java is not an executable"
    java_exe=$JAVA_HOME/bin/java
elif command -v java >/dev/null 2>&1; then
    java_exe=$(command -v java)
else
    # macOS has no /usr/lib/jvm/default (that fallback is the Arch layout): ask the
    # system helper first, then fall through to the JDX_JVM_DEFAULT_DIR escape hatch.
    # The helper path is a seam for tests ($JDX_JAVA_HOME_HELPER): sandbox tests point
    # it at nothing, and a fake helper script exercises this branch on any OS.
    java_home_helper=${JDX_JAVA_HOME_HELPER:-/usr/libexec/java_home}
    if [ -x "$java_home_helper" ]; then
        mac_home=$("$java_home_helper" -v "$minimum_java_major" 2>/dev/null \
            || "$java_home_helper" 2>/dev/null)
        if [ -n "$mac_home" ] && [ -x "$mac_home/bin/java" ]; then
            java_exe=$mac_home/bin/java
        fi
        unset mac_home
    fi
    if [ -z "$java_exe" ]; then
        default_jvm_dir=${JDX_JVM_DEFAULT_DIR:-/usr/lib/jvm/default}
        [ -x "$default_jvm_dir/bin/java" ] || die "no Java runtime found — set JAVA_HOME, add java to PATH, or point JDX_JVM_DEFAULT_DIR at a JDK (jdx needs Java $minimum_java_major+)"
        java_exe=$default_jvm_dir/bin/java
    fi
fi

version_output=$("$java_exe" -version 2>&1) || die "could not run '$java_exe -version' — is it a working JDK?"
version=$(printf '%s\n' "$version_output" | sed -n '1s/^.*version "\([^"]*\)".*/\1/p')
if [ -z "$version" ]; then
    first_line=$(printf '%s\n' "$version_output" | sed -n '1p')
    die "no version string in output of '$java_exe -version': $first_line"
fi

case $version in
    1.*) major=${version#*.} ;;
    *)   major=$version ;;
esac
major=${major%%[!0-9]*}
case $major in
    ''|*[!0-9]*) die "unrecognised Java version '$version' reported by '$java_exe'" ;;
esac

[ "$major" -ge "$minimum_java_major" ] || die "jdx requires Java $minimum_java_major+, but '$java_exe' is version '$version' — set JAVA_HOME to a newer JDK"

# AppCDS archive (T-048): shipped by :app:installDist next to the fat jar.
# Presence check only — -Xshare:auto below makes a stale archive a warning,
# never a failure, so no version probing here.
cds_archive=
if [ -f "$jdx_home/libs/jdx.jsa" ]; then
    cds_archive="-XX:SharedArchiveFile=$jdx_home/libs/jdx.jsa"
fi

if [ -n "$cds_archive" ]; then
    exec "$java_exe" -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -Xshare:auto "$cds_archive" -jar "$jar" "$@"
else
    exec "$java_exe" -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -Xshare:auto -jar "$jar" "$@"
fi
